# ==========================================
# Large Datasets & Archives (MUST NOT COMMIT TO GITHUB)
# GitHub blocks any single file > 100 MB
# ==========================================
*.zst
*.jsonl
*.h5
*.hdf5
*.tar.gz
*.zip
*.exe
stockfish/
stockfish/*.exe
lichess_db_eval*
data/zst_chunks/

# ==========================================
# Node.js & Frontend Build Outputs
# ==========================================
frontend/node_modules/
frontend/dist/
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# Python Environments & Caches
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.ipynb_checkpoints/
*.egg-info/

# ==========================================
# Local Secrets & Persistent Databases
# ==========================================
backend/.env
.env
backend/data/*.json
backend/data/local_db.json
*.log

# ==========================================
# OS & IDE Junk
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
